+          <div className="linha">
+            {(fonte.url || fonte.titulo) && !editandoFonte && <button onClick={() => setEditandoFonte(true)}>{tf.editarFonte}</button>}
+            {!dado && tipo !== 'lugar' && (
+              <button disabled={buscando} onClick={() => void buscar()}>{buscando ? '…' : tf.buscarFonte}</button>
+            )}
+            {(fonte.titulo || fonte.url) && (

+.cartao-fato.confirmado { border-left-color: var(--ok); }
+.cartao-fato.corrigido { border-left-color: var(--acento); }
+.cartao-fato.ignorado { border-left-color: var(--borda); opacity: .7; }
+.cabeca-fato { gap: 6px; }
+.cabeca-fato .espaco { flex: 1; }
+.cabeca-fato select { font-size: 12px; }
+.chip.status-fato.pendente { background: color-mix(in srgb, var(--aviso) 18%, transparent); color: var(--aviso); }
+.chip.status-fato.confirmado { background: color-mix(in srgb, var(--ok) 18%, transparent); color: var(--ok); }
+.chip.status-fato.corrigido { background: color-mix(in srgb, var(--acento) 18%, transparent); color: var(--acento); }
+.campo-fato { display: grid; gap: 3px; }
+.campo-fato .rotulo { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--texto-2); }
+.campo-fato input { width: 100%; box-sizing: border-box; }
+.campo-fato .link { justify-self: start; font-size: 12px; }
+.trecho-fato { font-style: italic; }
+.fonte-fato { display: grid; gap: 4px; }
+.fonte-fato .linha { gap: 6px; }
+.campos-fonte { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
+.campos-fonte input { min-width: 0; }
+.fonte-fato .chip { margin-left: 6px; }
+.aviso-txt { color: var(--aviso); font-size: 12px; }
+.opcoes-fonte { margin: 0; padding: 6px 8px; list-style: none; display: grid; gap: 4px; border: 1px solid var(--borda); border-radius: var(--raio); background: var(--fundo-2); }
+.acoes-fato { gap: 8px; }
